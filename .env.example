# ========================================================
# 🏡 RoamHaven Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ========================================================

# Application Port & Environment
PORT=8080
NODE_ENV=development

# MongoDB Atlas Database URI (or leave blank to fallback to local MongoDB)
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roamhaven?retryWrites=true&w=majority

# Session Encryption Secret
SECRET=your_super_secret_session_key_here

# Cloudinary Storage (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# OpenCage Geocoder API (for map coordinates)
OPENCAGE_API_KEY=your_opencage_api_key

# Google Gemini Generative AI (for AI Itinerary Planner & RoamMate Chatbot)
GOOGLE_API_KEY=your_gemini_api_key

# Google OAuth 2.0 (Optional - for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway (Test Mode)
# Leave as placeholder or obtain free test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_placeholderKey
RAZORPAY_KEY_SECRET=rzp_test_placeholderSecret
